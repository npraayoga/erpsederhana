generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Produk {
  id        Int      @id @default(autoincrement())
  nama      String
  kategori  String
  harga     Int
  stok      Int
  createdAt DateTime @default(now())
}

model Customer {
  id        Int      @id @default(autoincrement())
  nama      String
  email     String
  telp      String
  kota      String
  createdAt DateTime @default(now())
}

model Transaksi {
  id        Int      @id @default(autoincrement())
  customer  String
  produk    String
  jumlah    Int
  total     Int
  status    String
  tanggal   String
  createdAt DateTime @default(now())
}